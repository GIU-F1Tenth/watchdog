<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>watchdog</name>
  <version>1.0.0</version>
  <description>A ROS2 watchdog node for F1TENTH system monitoring and safety</description>
  <maintainer email="fam@awadlouis.com">Fam Shihata</maintainer>
  <author email="mo7ammed3zab@outlook.com">mohammedazab</author>
  <author>Nada Mahmoud</author>
  <license>MIT</license>

  <depend>rclpy</depend>
  
  <!-- Dependencies for custom messages -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
