<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>watchdog</name>
  <version>1.0.0</version>
  <description>A ROS2 watchdog node for F1TENTH system monitoring and safety</description>
  <maintainer email="fam@awadlouis.com">Fam Shihata</maintainer>
  <author email="mo7ammed3zab@outlook.com">mohammedazab</author>
  <author>Nada Mahmoud</author>
  <license>MIT</license>

  <depend>rclpy</depend>
  
  <!-- Build dependencies -->
  <build_depend>ament_cmake</build_depend>
  
  <!-- Sensor message dependencies -->
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vesc_msgs</depend>
  
  <!-- Dependencies for custom messages -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <depend>builtin_interfaces</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

  <member_of_group>rosidl_interface_packages</member_of_group>
</package>
